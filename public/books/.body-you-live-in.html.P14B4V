<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#ece0cc"><meta name="author" content="neoXhuman">
<title>The Body You Live In · neoXhuman</title>
<style>
:root{--ink:#111d42;--coral:#ee5d3d;--teal:#177d80;--paper:#fff9ec;--muted:#777265;--bh:min(79dvh,780px,calc(100dvh - 165px),calc((100vw - 52px)*1.5));color-scheme:light;font-family:Georgia,'Times New Roman',serif}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;overscroll-behavior:none}body{background:radial-gradient(ellipse at 45% 34%,#fff9ed 0%,#efe3cf 60%,#daccb6 100%);color:var(--ink);overflow:hidden}body::before{content:"";pointer-events:none;position:fixed;inset:0;opacity:.2;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' opacity='.12' filter='url(%23n)'/%3E%3C/svg%3E")}
button,input{font:inherit}button{color:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}button:focus-visible,input:focus-visible{outline:3px solid var(--coral);outline-offset:4px}button:disabled{opacity:.22;cursor:default}button{border:0;background:none}button svg{display:block;width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}a{color:var(--teal)}
.app{height:100dvh;display:grid;grid-template-rows:68px minmax(0,1fr) 74px;position:relative}.topbar{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:0 32px;z-index:5}.signature{font-size:20px;font-weight:bold;letter-spacing:-.5px}.book-name{font-family:Arial,sans-serif;text-transform:uppercase;letter-spacing:.18em;font-size:10px;color:#6b675f}.tools{display:flex;gap:6px}.icon{height:38px;width:38px;display:grid;place-items:center;border-radius:50%;transition:background .2s,color .2s}.icon:hover{background:#fff7e780}.icon[aria-pressed=true]{color:var(--coral)}
.stage{display:grid;place-items:center;position:relative;min-height:0;padding:5px 22px 14px;perspective:2000px}.volume{height:var(--bh);width:calc(var(--bh)*.6666667);max-width:calc(100vw - 44px);position:relative;isolation:isolate;filter:drop-shadow(0 30px 23px #4b352a2b);transform:rotateX(.5deg);transition:transform .55s}.volume[data-cover=true]{transform:rotateY(-4deg) rotateZ(-.35deg)}
.page-block{position:absolute;inset:5px -8px -7px 6px;border-radius:1px 7px 7px 2px;background:repeating-linear-gradient(0deg,#d3c5af 0px,#f9efdb 1px,#f9efdb 2px,#d7cab7 3px);box-shadow:1px 1px 0 #b5a58d,3px 3px 0 #f6ead5,4px 4px 0 #aa9579}.binding{position:absolute;left:-9px;top:1px;bottom:-6px;width:16px;border-radius:5px 0 0 5px;background:linear-gradient(90deg,#091330,#1c3159 40%,#0c1939 78%,#243452);box-shadow:inset 3px 0 7px #0005}
.book{position:absolute;inset:0;background:var(--paper);border-radius:1px 5px 5px 1px;overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none;box-shadow:-1px 0 1px #84725a5e,0 0 0 1px #b7a17e45;outline:none}.book::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,#39281b24,transparent 2.8%,transparent 96.5%,#80633c08);z-index:3}.page-img{display:block;width:100%;height:100%;object-fit:fill;background:var(--paper);pointer-events:none}.turn-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:2;pointer-events:none}.turn-canvas[hidden]{display:none}.corner{position:absolute;right:0;bottom:0;width:24px;height:26px;background:linear-gradient(135deg,transparent 48%,#f3e5cc 50%,#e1d1b6 72%,#fff9ec 75%);opacity:.48;z-index:4;pointer-events:none;transition:opacity .2s}.book:hover .corner{opacity:.9}.ribbon{position:absolute;right:25px;top:-5px;width:18px;height:52px;background:linear-gradient(90deg,#c9492e,#ef6847 50%,#c7492d);clip-path:polygon(0 0,100% 0,100% 100%,50% 82%,0 100%);z-index:6;filter:drop-shadow(1px 2px 2px #0003)}.ribbon[hidden]{display:none}
.nav-bar{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;z-index:4;padding:3px 20px 13px}.navigation{display:flex;align-items:center;gap:18px}.arrow{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:#fff7e6a8;box-shadow:0 1px 2px #695d4520}.arrow:hover{background:#fffaf0}.counter{font-family:Arial,sans-serif;font-size:11px;font-variant-numeric:tabular-nums;letter-spacing:.1em;min-width:82px;text-align:center;color:#6f675b}.open-label{font:12px Arial,sans-serif;color:var(--ink);min-width:85px}.progress{width:min(230px,60vw);height:2px;accent-color:var(--teal);cursor:pointer;margin:0;opacity:.68}.resume{position:absolute;bottom:0;left:50%;transform:translate(-50%,100%);white-space:nowrap;font:10px Arial,sans-serif;color:#7f6b56;padding:6px 12px;background:#fff9ec99;border-radius:20px}.resume[hidden]{display:none}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
dialog{border:0;color:var(--ink);background:var(--paper);box-shadow:0 20px 70px #111d4233}dialog::backdrop{background:#15243c48;backdrop-filter:blur(5px)}.drawer{position:fixed;inset:0 0 0 auto;margin:0;width:min(430px,94vw);height:100dvh;max-height:none;padding:28px 26px 20px;border-radius:16px 0 0 16px;overflow:auto}.dialog-head{display:flex;align-items:center;justify-content:space-between;gap:20px}.dialog-head h2{font-size:27px;margin:0}.subtitle{font:11px Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--teal);margin:11px 0 22px}.search{width:100%;padding:13px 14px;border:1px solid #cdbfa8;border-radius:5px;background:#fffdf6;color:var(--ink);font:13px Arial,sans-serif}.tabs{display:flex;gap:22px;border-bottom:1px solid #e2d4bd;margin:20px 0 10px}.tab{font:12px Arial,sans-serif;padding:9px 0;border-bottom:2px solid transparent;color:#7c7468}.tab[aria-selected=true]{color:var(--teal);border-color:var(--teal)}.toc-list{display:flex;flex-direction:column;margin-bottom:24px}.toc-item{padding:14px 0;display:flex;align-items:baseline;justify-content:space-between;gap:16px;text-align:left;border-bottom:1px solid #ecdfc8;font-size:16px;line-height:1.35}.toc-item small{font:10px Arial,sans-serif;color:#8c8070;white-space:nowrap}.toc-item:hover{color:var(--coral)}.empty{font:13px/1.65 Arial,sans-serif;color:#817462;padding:25px 0}.setting{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-top:1px solid #dfd0b5;font:12px Arial,sans-serif}.toggle{padding:7px 13px;background:#e7dece;border-radius:20px;font:11px Arial,sans-serif}.toggle[aria-pressed=true]{background:var(--teal);color:white}.quiet-note{font:11px/1.6 Arial,sans-serif;color:#8b7c67;margin-top:20px}
.reading{width:min(760px,96vw);height:min(900px,95dvh);max-height:95dvh;border-radius:12px;padding:26px 34px;overflow:auto}.read-controls{position:sticky;top:-26px;z-index:3;display:flex;justify-content:space-between;align-items:center;background:var(--paper);padding:4px 0 16px;border-bottom:1px solid #e7d7bd}.read-controls .sizes{display:flex;gap:8px;align-items:center}.size-button{border:1px solid #dfd0b8;border-radius:5px;height:32px;width:36px;font:14px Georgia,serif}.reading article{font-size:19px;line-height:1.72;max-width:36em;margin:24px auto}.reading h1{font:700 1.7em/1.2 Georgia,serif;letter-spacing:-.02em}.reading .read-kicker{font:11px Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--teal)}.read-picture{width:100%;height:auto;margin:0 0 20px;display:block}.read-picture[hidden]{display:none}.reading p{margin:1em 0}.reading .read-sources{font:12px/1.6 Arial,sans-serif;border-top:1px solid #e2d2b8;padding-top:16px}.read-navigation{display:flex;justify-content:space-between;margin:30px 0 10px}.read-navigation button{font:13px Arial,sans-serif;padding:11px 14px;background:#eee4d2;border-radius:5px}.read-sources a{display:block;margin-bottom:8px}
.toast{position:fixed;bottom:98px;left:50%;transform:translateX(-50%);padding:10px 16px;border-radius:24px;color:var(--paper);background:#172346eb;font:11px Arial,sans-serif;z-index:20;pointer-events:none;opacity:0;transition:opacity .2s}.toast.visible{opacity:1}
@media(max-width:650px){:root{--bh:min(calc(100dvh - 146px),calc((100vw - 42px)*1.5))}.app{grid-template-rows:54px minmax(0,1fr) 75px}.topbar{padding:0 15px;gap:6px}.signature{font-size:17px}.book-name{display:none}.tools{gap:2px}.icon{width:34px;height:34px}.stage{padding:4px 18px 15px}.volume{filter:drop-shadow(0 18px 16px #4b352a28)}.reading{padding:20px}.read-controls{top:-20px}.reading article{font-size:18px}.drawer{padding:23px 20px}.resume{font-size:10px}.toast{max-width:85vw;text-align:center}.nav-bar{gap:8px}}
@media(max-height:620px) and (min-width:651px){:root{--bh:calc(100dvh - 140px)}.app{grid-template-rows:48px minmax(0,1fr) 64px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important}.volume{transform:none!important}}
@media print{body{overflow:visible;background:white}.topbar,.nav-bar,.page-block,.binding,.corner,.ribbon{display:none}.app{display:block}.stage{padding:0}.volume{height:100vh;width:66.66vh;transform:none;filter:none}.book{box-shadow:none}.page-img{width:100%;height:auto}}
</style>

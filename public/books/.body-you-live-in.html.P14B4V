<dialog class="drawer" id="contentsDialog"><div class="dialog-head"><h2>Inside the book</h2><button class="icon" id="closeContents" aria-label="Close contents"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div><p class="subtitle">99 discoveries · neoXhuman</p><input class="search" id="search" type="search" placeholder="Find a fact or a chapter" aria-label="Search the book"><div class="tabs"><button class="tab" id="chaptersTab" aria-selected="true">Chapters</button><button class="tab" id="savedTab" aria-selected="false">Bookmarked pages</button></div><div class="toc-list" id="tocList"></div><div class="setting"><span>Paper-turn sound</span><button class="toggle" id="soundButton" aria-pressed="false">Off</button></div><p class="quiet-note">Swipe, use the arrows, or turn from a page edge. Your reading place is remembered on this device.</p></dialog>
